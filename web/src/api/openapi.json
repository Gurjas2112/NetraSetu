              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/QueuedBody"
                    },
                    {
                      "$ref": "#/components/schemas/ErrorBody"
                    }
                  ],
                  "title": "Response 503 Analyze Analyze Post"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
