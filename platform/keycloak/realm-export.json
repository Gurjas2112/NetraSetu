{
  "id": "netrasetu",
  "realm": "netrasetu",
  "displayName": "NetraSetu",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "browserFlow": "netrasetu browser",
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyInitialCounter": 0,
  "otpPolicyDigits": 6,
  "otpPolicyLookAheadWindow": 1,
  "otpPolicyPeriod": 30,
  "roles": {
    "realm": [
      {
        "name": "screener",
        "description": "Field screening. OTP is not required."
      },
      {
        "name": "otp-required",
        "description": "Forces TOTP. Included by grader and admin; screeners never receive it."
      },
      {
        "name": "grader",
        "description": "Signs a grade. TOTP required. Must not also hold admin.",
        "composite": true,
        "composites": { "realm": ["otp-required"] }
      },
      {
        "name": "admin",
        "description": "Programme administration. TOTP required. Must not also hold grader.",
        "composite": true,
        "composites": { "realm": ["otp-required"] }
      }
    ]
  },
  "clients": [
    {
      "clientId": "netrasetu-web",
      "name": "NetraSetu web",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "fullScopeAllowed": true,
      "redirectUris": ["http://localhost:5173/*"],
      "webOrigins": ["http://localhost:5173"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*"
      },
      "protocolMappers": [
        {
          "name": "audience-gateway",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "netrasetu-gateway",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "hpr-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "hpr_id",
            "claim.name": "hpr_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "amr",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-amr-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "facility",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "facility_id",
            "claim.name": "facility_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "netrasetu-gateway",
      "name": "NetraSetu gateway audience",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "redirectUris": [],
      "webOrigins": []
    }
  ],
  "requiredActions": [
    {
      "alias": "CONFIGURE_TOTP",
      "name": "Configure OTP",
      "providerId": "CONFIGURE_TOTP",
      "enabled": true,
      "defaultAction": false,
      "priority": 10,
      "config": {}
    }
  ],
  "authenticationFlows": [
    {
      "id": "c0ffee00-0000-4000-8000-000000000001",
      "alias": "netrasetu browser",
      "description": "Browser login. OTP is required only for the otp-required role.",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "authenticatorFlow": false,
          "autheticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticatorFlow": true,
          "autheticatorFlow": true,
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "flowAlias": "netrasetu browser forms",
          "userSetupAllowed": false
        }
      ]
    },
    {
      "id": "c0ffee00-0000-4000-8000-000000000002",
      "alias": "netrasetu browser forms",
      "description": "Username and password, then conditional OTP.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-username-password-form",
          "authenticatorConfig": "amr-password",
          "authenticatorFlow": false,
          "autheticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticator": "auth-conditional-otp-form",
          "authenticatorConfig": "otp-for-privileged",
          "authenticatorFlow": false,
          "autheticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "id": "c0ffee00-0000-4000-8000-000000000003",
      "alias": "otp-for-privileged",
      "config": {
        "forceOtpRole": "otp-required",
        "defaultOtpOutcome": "skip",
        "default.reference.value": "otp"
      }
    },
    {
      "id": "c0ffee00-0000-4000-8000-000000000004",
      "alias": "amr-password",
      "config": {
        "default.reference.value": "pwd"
      }
    }
  ]
}
