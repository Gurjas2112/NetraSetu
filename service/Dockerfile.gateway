# Gateway image for Railway / any container host. No MATLAB, deliberately.
FROM python:3.12-slim
WORKDIR /app
COPY service/requirements-gateway.txt .
RUN pip install --no-cache-dir -r requirements-gateway.txt
COPY service/ ./service/
COPY matlab/config/threshold.json ./matlab/config/threshold.json
ENV GATEWAY_MODE=queue
ENV NX_ROOT=/app/matlab
ENV PYTHONUNBUFFERED=1
CMD ["sh", "-c", "uvicorn service.main:create_app --factory --host 0.0.0.0 --port ${PORT:-8000}"]
